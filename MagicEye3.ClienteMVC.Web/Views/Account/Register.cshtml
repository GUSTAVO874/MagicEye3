@model MagicEye3.ClienteMVC.Web.Models.RegistrationRequestDto

@{
    ViewBag.Title = "Registro";
    var roleList = ViewBag.RoleList as List<string>;
}

<h3>Registro</h3>

@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "mt-5" }))
{
    @Html.AntiForgeryToken()

    @* Mostrar errores generales *@
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Role, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.Role, new SelectList(roleList, ""), "--Selecciona un rol--", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary mt-3">Registrarse</button>
}
